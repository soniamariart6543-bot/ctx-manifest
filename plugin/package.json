{
  "name": "dsh-ctx-manifest",
  "version": "0.1.0",
  "description": "DSH plugin: mount ctx-manifest — budgeted, auditable context assembly — as tools, a read-only status route and an optional injection hook.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context-engineering",
    "manifest"
  ]
}
